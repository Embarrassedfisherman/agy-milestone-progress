{
  "milestone-progress": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./hooks/progress_hook.py",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/progress_hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./hooks/progress_hook.py",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./hooks/progress_hook.py",
        "timeout": 5
      }
    ]
  }
}
